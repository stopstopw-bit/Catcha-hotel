{
  "framework": "nextjs",
  "regions": ["sin1"],
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/morning-summary",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/daily-close",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 19 1 * *"
    }
  ]
}
